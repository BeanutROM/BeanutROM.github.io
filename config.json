{
  "site": {
    "name": "Beanut Translations",
    "description": "Game translation projects and releases from BeanutROM.",
    "github_url": "https://github.com/BeanutROM"
  },
  "discovery": {
    "owners": [
      "BeanutROM"
    ],
    "include_topics_any": [
      "fan-translation",
      "english-translation",
      "game-translation",
      "translation-patch",
      "romhack",
      "localization"
    ],
    "include_description_matches": [
      "fan translation",
      "english translation",
      "english patch",
      "translation patch",
      "localization project",
      "localisation project",
      "romhack",
      "rom hack"
    ],
    "include_repositories": [],
    "exclude_repositories": [
      "BeanutROM/BeanutROM.github.io"
    ],
    "include_forks": false,
    "include_all_owner_repos": true,
    "search_queries": [],
    "search_results_per_query": 20,
    "max_projects": 150
  },
  "overrides": {
    "BeanutROM/PSX-Gear-Fighter-Dendoh-English-Patch": {
      "title": "Gear Fighter Dendoh",
      "igdb_query": "Gear Senshi Dendoh"
    },
    "BeanutROM/PSP-Last-Ranker-Complete-English-Patch": {
      "title": "Last Ranker",
      "igdb_query": "Last Ranker"
    },
    "BeanutROM/PSX-Mystic-Dragoons-Complete-English-Patch": {
      "title": "Mystic Dragoons, The",
      "igdb_query": "The Mystic Dragoons"
    },
    "BeanutROM/PSX-Athena-English-Patch": {
      "title": "Athena: Awakening from the Ordinary Life",
      "igdb_query": "Athena Awakening from the Ordinary Life"
    }
  },
  "igdb": {
    "enabled": true,
    "use_summaries": true
  },
  "external_links": {
    "enabled": true
  },
  "youtube": {
    "enabled": true,
    "max_videos": 1000,
    "max_per_game": 5
  },
  "thumbnails": {
    "enabled": true,
    "width": 320,
    "quality": 76,
    "max_source_bytes": 16777216
  }
}
